---
// Small stroke icons used by links and buttons.
interface Props { name: 'chevron' | 'arrow' | 'out' | 'down' }
const { name } = Astro.props;
const paths = {
  chevron: { vb: '0 0 12 12', d: 'm4.5 2.5 3.5 3.5-3.5 3.5' },
  arrow: { vb: '0 0 14 14', d: 'M2 7h9M7.5 3.5 11 7l-3.5 3.5' },
  out: { vb: '0 0 12 12', d: 'M3.5 8.5 8.5 3.5M4.5 3.5h4v4' },
  down: { vb: '0 0 14 14', d: 'M7 2v7M3.8 6 7 9.2 10.2 6M2.5 12h9' },
}[name];
---
<svg viewBox={paths.vb} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths.d} /></svg>

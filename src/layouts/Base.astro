---
import '../styles/global.css';
import fontUrl from '../assets/fonts/geist-latin.woff2?url';
import profile from '../data/profile.json';

interface Props { title?: string; description?: string; noindex?: boolean; preload?: string }
const { title = profile.seo.title, description = profile.seo.description, noindex = false, preload } = Astro.props;
// The browser tab shows just the name so it isn't cut off; link previews keep the friendlier SEO title.
const tabTitle = Astro.props.title ?? profile.name;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = new URL(path, Astro.site).href;
const share = new URL(`${base}/share.jpg?v=2`, Astro.site).href;
const shareHi = new URL(`${base}/share-2x.jpg?v=2`, Astro.site).href; // 2400×1260, the sharp copy for X and retina feeds
const shareAlt = `${profile.name}, ${profile.role.toLowerCase()}, beside a 3D model of Delhi at night: Qutub Minar, Jama Masjid, India Gate, the Lotus Temple and Humayun’s Tomb under a glowing moon.`;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  url: new URL(`${base}/`, Astro.site).href,
  email: profile.email && !profile.email.endsWith('.example') ? profile.email : undefined,
  address: { '@type': 'PostalAddress', addressLocality: 'Delhi', addressCountry: 'IN' },
  knowsAbout: profile.stack,
  sameAs: [profile.links.github, profile.links.linkedin].filter(Boolean),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tabTitle}</title>
    <meta name="description" content={description} />
    <script is:inline>document.documentElement.classList.add("js")</script>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0a0d14" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={`${base}/favicon-32.png?v=2`} sizes="32x32" type="image/png" />
    <link rel="icon" href={`${base}/favicon.svg?v=2`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png?v=2`} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    {preload && <link rel="preload" href={preload} as="fetch" type="model/gltf-binary" crossorigin="anonymous" fetchpriority="high" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={share} />
    <meta property="og:image:secure_url" content={share} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareHi} />
    <meta name="twitter:image:alt" content={shareAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <slot />
    <script is:inline>
      // Favicon "U_": blink the sky-blue cursor by swapping between two frames.
      // Browsers don't animate favicons on their own; reduced motion keeps it still.
      (() => {
        const icon = document.querySelector('link[rel="icon"][type="image/svg+xml"]');
        if (!icon || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const on = icon.href, off = on.replace('favicon.svg', 'favicon-blink.svg');
        new Image().src = off;
        let lit = true;
        setInterval(() => { lit = !lit; icon.href = lit ? on : off; }, 600);
      })();
    </script>
  </body>
</html>
